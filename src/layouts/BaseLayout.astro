---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
const { title = '评机场', description = '机场评测、机场推荐、节点测速与风险观察。' } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><SeoHead title={title} description={description} /></head><body><a class="skip-link" href="#main-content">跳到正文</a><Header /><main id="main-content"><slot /></main><Footer /></body></html>
