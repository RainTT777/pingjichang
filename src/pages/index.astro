---
import Base from '../layouts/BaseLayout.astro';
import { airports } from '../data/airports';
const rankings = [
  { rank: '01', name: 'EdgeNova 边缘节点', label: '稳定之选', score: 92, slug: 'sample-a' },
  { rank: '02', name: '光年梯', label: '性价比', score: 88, slug: 'sample-b' },
  { rank: '03', name: '极连云', label: 'Clash 友好', score: 86, slug: 'sample-c' }
];
---
<Base title="机场推荐、评测与测速观察" description="评机场提供机场推荐、机场评测、晚高峰测速、Clash 与 Shadowrocket 教程以及机场风险观察。">
<section class="portal-hero"><div class="container portal-grid"><article class="hero-story"><div class="hero-content"><span class="story-tag">本月焦点 · 演示数据</span><h1>机场推荐，不应该只看一张速度截图。</h1><p>持续记录稳定性、晚高峰、节点质量、套餐价格与风险变化，并公开每一项评分权重。</p><div class="hero-actions"><a class="button button-light" href="/rankings/">查看推荐榜</a><a class="outline-link" href="/methodology/">了解评分标准</a></div></div><div class="signal-art" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span><span class="signal-core">92<small>综合评分</small></span></div></article><aside class="hero-side"><a class="side-story blue" href="/reports/october-2026/"><span>风险观察</span><h2>机场是否跑路？先看这 5 类变化</h2><p>公告、套餐、节点、退款与客服状态。</p></a><a class="side-story dark" href="/tutorials/clash/"><span>新手教程</span><h2>Clash 订阅导入与基础排错</h2><p>从订阅链接到节点选择的完整流程。</p></a></aside></div></section>
<section class="score-strip"><div class="container score-strip-inner"><div class="strip-title"><span>TOP RANKING</span><strong>本月机场推荐榜</strong></div>{rankings.map(item => <a class="strip-item" href={`/reviews/${item.slug}/`}><b>{item.rank}</b><span><strong>{item.name}</strong><small>{item.label}</small></span><em>{item.score}</em></a>)}<a class="strip-more" href="/rankings/">完整榜单 →</a></div></section>
<section class="section"><div class="container content-layout"><div class="main-column"><div class="portal-heading"><div><span>LATEST REVIEWS</span><h2>最新机场评测</h2></div><a href="/reviews/">全部评测 →</a></div><div class="news-grid"><article class="lead-card"><div class="card-visual visual-a"><span>92</span></div><div class="card-body"><span class="category">稳定机场 · 演示数据</span><h3><a href="/reviews/sample-a/">EdgeNova 边缘节点：稳定性与晚高峰记录</a></h3><p>展示套餐价格、节点区域、协议支持、测速记录和风险披露的完整评测结构。</p><div class="meta">更新于 2026-10-03 · 最近测试 20:00</div></div></article><div class="small-news"><article><div class="mini-visual v-blue">88</div><div><span class="category">性价比</span><h3><a href="/reviews/sample-b/">光年梯 套餐与流量分析</a></h3><div class="meta">演示数据 · 6 分钟阅读</div></div></article><article><div class="mini-visual v-red">86</div><div><span class="category">Clash 机场</span><h3><a href="/reviews/sample-c/">极连云 客户端兼容性测试</a></h3><div class="meta">演示数据 · 5 分钟阅读</div></div></article><article><div class="mini-visual v-gold">79</div><div><span class="category">风险观察</span><h3><a href="/reviews/sample-d/">速界 退款与客服记录</a></h3><div class="meta">演示数据 · 4 分钟阅读</div></div></article></div></div></div><aside class="sidebar"><div class="sidebar-title"><span>LIVE TESTS</span><h2>近期测速</h2></div><div class="test-fixture"><div><span>EdgeNova 边缘节点</span><strong>120<small>Mbps</small></strong></div><i>20:00</i><div><span>晚高峰延迟</span><strong>180<small>ms</small></strong></div></div><div class="test-fixture"><div><span>光年梯</span><strong>86<small>Mbps</small></strong></div><i>21:00</i><div><span>晚高峰延迟</span><strong>240<small>ms</small></strong></div></div><a class="sidebar-link" href="/reports/">查看所有测速记录 →</a><div class="disclosure-box"><span>透明披露</span><h3>返佣不会自动等于排名靠前</h3><p>包含联盟链接的内容会明确标注。</p><a href="/disclosure/">查看披露说明</a></div></aside></div></section>
<section class="section dark-section"><div class="container"><div class="portal-heading light"><div><span>RANKING TABLE</span><h2>机场评分积分榜</h2></div><a href="/rankings/">查看完整数据 →</a></div><div class="standings"><div class="standings-head"><span>排名 / 机场</span><span>稳定</span><span>高峰</span><span>速度</span><span>综合</span></div>{rankings.map(item => <a class="standing-row" href={`/reviews/${item.slug}/`}><span><b>{item.rank}</b><i class={`airport-icon icon-${item.rank}`}>评</i><strong>{item.name}<small>{item.label} · 演示数据</small></strong></span><span>23/25</span><span>17/20</span><span>13/15</span><em>{item.score}</em></a>)}</div></div></section>
<section class="section"><div class="container"><div class="portal-heading"><div><span>GUIDES & INSIGHTS</span><h2>教程与风险观察</h2></div><a href="/tutorials/">浏览全部 →</a></div><div class="guide-grid"><a class="guide-card feature-guide" href="/tutorials/clash/"><span>CLASH</span><h3>Clash 配置、订阅更新与节点选择</h3><p>适合第一次使用代理客户端的基础指南。</p><b>开始阅读 →</b></a><a class="guide-card" href="/tutorials/shadowrocket/"><span>SHADOWROCKET</span><h3>小火箭订阅导入教程</h3><p>订阅更新、策略选择和常见错误。</p></a><a class="guide-card" href="/tutorials/speedtest/"><span>测速方法</span><h3>如何科学记录节点测速</h3><p>控制时间和网络环境，减少误判。</p></a><a class="guide-card" href="/reports/october-2026/"><span>月度观察</span><h3>2026 年 10 月机场风险观察</h3><p>演示状态变化、退款和公告记录。</p></a></div></div></section>
<section class="method-banner"><div class="container method-banner-inner"><div><span>OUR STANDARD</span><h2>8 项指标，100 分制，持续更新。</h2></div><p>稳定性 25 · 晚高峰 20 · 速度 15 · 节点质量 10 · 流媒体 10 · 性价比 10 · 客服退款 5 · 信息透明度 5</p><a class="button button-light" href="/methodology/">查看评测标准</a></div></section>
<section class="section airport-featured"><div class="container"><div class="portal-heading"><div><span>EDITORIAL PICKS</span><h2>编辑精选机场</h2></div><a href="/rankings/">查看全部 {airports.length} 个机场 →</a></div><div class="airport-featured-grid">{airports.slice(0, 6).map((airport) => <a class="airport-featured-card" href={airport.url} target="_blank" rel="nofollow sponsored noopener"><strong>{airport.name}</strong><span>{airport.category}</span><small>{airport.note}</small><b>访问官网 ↗</b></a>)}</div></div></section>
</Base>

